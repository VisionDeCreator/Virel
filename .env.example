# Client and service environment templates live beside each application.
# Convex development deployment configuration is created in packages/backend
# by `bun run dev:convex`. Never put auth signing keys in client variables.

# Planned Remix integrations (server-only; leave empty until configured).
# R2 stores source/reference media, generated outputs, and large files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Rendering provider; verify the live contract before enabling generation.
SUME_API_KEY=
SUME_BASE_URL=

# Optional Cinakey-compatible vision analysis; not required to enable Remix.
# Google video analysis is deferred and has no configuration in this release.
DEEPSEEK_API_KEY=

# Planned authenticated API/worker-to-backend communication.
# Use a separate strong secret for each boundary when implemented.
API_SERVICE_SECRET=
WORKER_SERVICE_SECRET=
