# Client and service environment templates live beside each application.
# Convex development deployment configuration is created in packages/backend
# by `bun run dev:convex`. Never put auth signing keys in client variables.

# Planned Remix integrations (server-only; leave empty until configured).
# R2 stores source/reference media, generated outputs, and large files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Rendering provider; verify the live contract before enabling generation.
SUME_API_KEY=
SUME_BASE_URL=

# Optional Cinakey-compatible vision analysis; not required to enable Remix.
# Google video analysis is deferred and has no configuration in this release.
DEEPSEEK_API_KEY=

# Optional reserved service credentials. Current API/worker access uses CONVEX_DEPLOY_KEY.
# Use a separate strong secret for each boundary when implemented.
API_SERVICE_SECRET=
WORKER_SERVICE_SECRET=

CREDITS_PER_USD=100
GENERATION_MARKUP_BPS=3000
WELCOME_CREDITS=100
STUDIO_WEB_ORIGINS=http://localhost:5173

# Optional Cloudflare media Worker deployment (deployment tooling only).
# Leave blank until Worker deployment is configured; never expose to clients.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
MEDIA_DOMAIN=

CONVEX_DEPLOY_KEY=

API_PUBLIC_URL=

CONVEX_URL=

# R2 and SUME secrets belong to API/worker hosting, never Convex or client variables.
