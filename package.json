{
  "name": "virel",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@virel/web --filter=@virel/api --filter=@virel/worker",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:admin": "bun run --cwd apps/admin dev",
    "dev:mobile": "bun run --cwd apps/mobile dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:convex": "bun run --cwd packages/backend dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tools.json",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:web": "playwright test",
    "setup:clients": "bun scripts/connect-clients.ts",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "setup:studio": "bun packages/backend/scripts/configure-studio.ts",
    "dev:worker": "bun run --cwd apps/worker dev",
    "check:studio-storage": "bun apps/api/src/check-storage.ts",
    "test:studio": "STUDIO_STORAGE_ACCEPTANCE=1 playwright test --config playwright.auth.config.ts",
    "admin:promote": "bun --no-env-file scripts/promote-admin.ts",
    "test:admin": "playwright test --config playwright.admin.config.ts",
    "test:admin:runtime": "playwright test --config playwright.admin-runtime.config.ts",
    "credits:migrate": "bun --no-env-file scripts/migrate-credits.ts",
    "check:generation": "bun --no-env-file apps/api/src/cli/check-generation.ts"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "turbo": "^2.5.4",
    "prettier": "^3.6.2",
    "vitest": "^4.0.0",
    "@types/bun": "^1.3.0",
    "@playwright/test": "^1.56.0"
  }
}
